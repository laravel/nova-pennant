{
    "name": "laravel/nova-pennant",
    "description": "A Pennant Resource Tool for Laravel Nova",
    "type": "library",
    "keywords": [
        "laravel",
        "laravel-nova",
        "laravel-pennant"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        },
        {
            "name": "Mior Muhammad Zaki",
            "email": "mior@laravel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.48.29|^11.44.1|^12.1.1",
        "laravel/nova": "^5.7.7",
        "laravel/pennant": "^1.16.1",
        "symfony/polyfill-php83": "^1.32"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.8.13",
        "laravel/pint": "^1.20",
        "orchestra/pest-plugin-testbench": "^2.0|^3.0",
        "orchestra/testbench": "^8.24|^9.2|^10.0",
        "phpstan/phpstan": "^2.1.15",
        "spatie/laravel-ray": "^1.40.2"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Nova\\PennantTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "repositories": [
        { "type": "composer", "url": "https://nova.laravel.com" }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Nova\\PennantTool\\ToolServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
